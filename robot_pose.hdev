<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="21.05.0.0">
<procedure name="main">
<interface/>
<body>
<l>Protocol := 'TCP4'</l>
<l>Timeout := 3.0</l>
<l>open_socket_connect ('10.0.1.0', 30003, ['protocol','timeout'], [Protocol,Timeout], Socket)</l>
<l>get_socket_param (Socket, 'address_info', Address)</l>
<l>UR_socket_read_tool_pose (Socket, Base_H_Tool_m)</l>
<c></c>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
<procedure name="UR_socket_read_tool_pose">
<interface>
<ic>
<par name="Socket" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Base_H_Tool_m" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>*适用UR系统版本V3.7</c>
<l>receive_data (Socket, ['i'], MessageSize, From)</l>
<l>receive_data (Socket, ['d'], Time, From)</l>
<l>receive_data (Socket, ['d6'], TargetJointPositions, From)</l>
<l>tuple_deg (TargetJointPositions, Joint)</l>
<l>receive_data (Socket, ['d48'], Answer, From)</l>
<l>receive_data (Socket, ['d6'], Actual, From)</l>
<l>receive_data (Socket, ['d12'], Answer, From)</l>
<l>receive_data (Socket, ['d6'], Target, From)</l>
<l>receive_data (Socket, ['c472'], Answer, From)</l>
<l>RotVector := [Target[3:5]]</l>
<l>theta := sqrt(sum(RotVector * RotVector))</l>
<l>create_matrix (3, 3, [1, 0,0,0,1,0,0,0,1], I)</l>
<l>RotVectorNorm := RotVector / sqrt(sum(RotVector * RotVector))</l>
<l>create_matrix (3, 1, RotVectorNorm, r)</l>
<l>transpose_matrix (r, rT)</l>
<l>CosTheta := cos(theta)</l>
<l>scale_matrix (I, CosTheta, CosThetaI)</l>
<l>r_ := RotVectorNorm</l>
<l>create_matrix (3, 3, [0,-r_[2],r_[1],r_[2],0,-r_[0],-r_[1],r_[0],0], AntisymmetricMatrix)</l>
<l>mult_matrix (r, rT, 'AB', r_rT)</l>
<l>scale_matrix (r_rT, 1-CosTheta, _1_Cosr_rT)</l>
<l>add_matrix (CosThetaI, _1_Cosr_rT, MatrixSumID)</l>
<l>SinTheta := sin(theta)</l>
<l>scale_matrix (AntisymmetricMatrix, SinTheta, SinTheta_AntisymmetricMatrix)</l>
<l>add_matrix (MatrixSumID, SinTheta_AntisymmetricMatrix, RotationMatrix)</l>
<l>transpose_matrix (RotationMatrix, RotationMatrix_T)</l>
<l>mult_matrix (RotationMatrix, RotationMatrix_T, 'AB', A_AT)</l>
<l>determinant_matrix (RotationMatrix, 'general', RotationMatrix_det)</l>
<l>determinant_matrix (A_AT, 'general', det)</l>
<l>tuple_string (RotationMatrix_det, '.1f', String)</l>
<l>if (String!='1.0')</l>
<l>    stop ()</l>
<l>    dev_disp_text ('获取位姿error', 'window', 'top', 'left', 'black', [], [])</l>
<l>    return ()</l>
<l>endif</l>
<l>get_full_matrix (RotationMatrix, R)</l>
<l>sy := 0.0000000000000000000000000000000001</l>
<c></c>
<l>if (R[0]*R[0]+R[3]*R[3] &gt; sy)</l>
<l>    theta_y := atan2(-R[6],sqrt(R[7]*R[7]+R[8]*R[8]))</l>
<l>    RY := deg(theta_y)</l>
<l>    theta_x := atan2(R[7]/cos(theta_y),R[8]/cos(theta_y))</l>
<l>    RX := deg(theta_x)</l>
<l>    theta_z := atan2(R[3]/cos(theta_y),R[0]/cos(theta_y))</l>
<l>    RZ := deg(theta_z)</l>
<l>else</l>
<l>    theta_x := atan2(-R[5],R[4])</l>
<l>    RX := deg(theta_x)</l>
<l>    theta_y := atan2(-R[6],sy)</l>
<l>    RY := deg(theta_y)</l>
<l>    RZ := 0</l>
<l>endif</l>
<l>create_pose (Target[0], Target[1], Target[2], RX, RY, RZ, 'Rp+T', 'abg', 'point', Base_H_Tool_m)</l>
<c></c>
<c></c>
<c></c>
<c></c>
<c></c>
<l>return ()</l>
</body>
<docu id="UR_socket_read_tool_pose">
<parameters>
<parameter id="Base_H_Tool_m"/>
<parameter id="Socket"/>
</parameters>
</docu>
</procedure>
</hdevelop>
